<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-API31 fallback for allowBackup=false + data_extraction_rules (API31+).
     Excludes everything so history/photos never leave device (privacy-first). -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>